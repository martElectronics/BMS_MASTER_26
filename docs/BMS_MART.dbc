CM_ BO_ 14 "Ultimo episodio (ID 0x0E, 500ms). BMS_RetryNet sustituye desde 2026-10-10 al antiguo numTriesReset duplicado: signo = causa del ultimo ciclo (+COMM/-CRC), magnitud = reintentos.";
CM_ BO_ 15 "BMS_DEBUG (ID 0x0F, 100ms) - el frame clave para diagnosticar caidas de BMS_OK en pista. Ver docs/CAN_Solo2DL.md #8.";
CM_ SG_ 14 BMS_RetryNet "Short AiM: RTRN. +N = N reintentos por COMM (board mudo) en el ultimo ciclo V+T. -N = N reintentos por CRC (dato corrupto). 0 = ciclo limpio. Ver docs/inmunidad_ruido.md #3.3.";
CM_ SG_ 15 BMS_Flt_Comm "Short AiM: FCOM.";
CM_ SG_ 15 BMS_Fault "Short AiM: BFLT. OR global de fallo confirmado (no-latching; el latch real del SDC es HW).";
CM_ SG_ 15 FirstFault "Short AiM: FFLT. Enum: 0=none 1=V 2=T 3=NTC 4=Comm 5=Hall 6=NoInit.";
CM_ SG_ 15 Pin_SDC_3V3 "Short AiM: PSDC.";

CM_ BO_ 18 "Corriente y tension del pack medidas por el BMS (ID 0x12, 100ms). Medida independiente del inversor para el balance de potencia.";
CM_ SG_ 18 BMS_PackCurrent "Sensor Hall (DHAB) del BMS. + descarga, - carga.";
CM_ SG_ 18 BMS_PackVoltage "Suma de las tensiones de todas las celdas leidas por los BQ.";

VAL_ 15 FirstFault 0 "none" 1 "V" 2 "T" 3 "NTC" 4 "Comm" 5 "Hall" 6 "NoInit" ;

CM_ BO_ 993 "Inversor DTI HV-500, packet 0x1F (CAN manual v2.5 Tabla4 S3.2). CANID=(Packet<<5)|NodeID, NodeID=1 confirmado via DTI CAN Tool.";
CM_ BO_ 1025 "Packet 0x20. ERPM = RPM electrico (dividir por pares de polos del motor para RPM mecanico).";
CM_ BO_ 1057 "Packet 0x21.";
CM_ BO_ 1089 "Packet 0x22. INV_FaultCode distingue fallo del INVERSOR de un fallo del BMS (ver VAL_ de este signal).";
CM_ BO_ 1121 "Packet 0x23. Componentes FOC Id/Iq, uso avanzado/debug de control.";
CM_ BO_ 1153 "Packet 0x24. Throttle/Brake/IO digital/bits de limite activo/DriveEnable/version de mapa CAN.";
CM_ BO_ 1185 "Packet 0x25. avail = limite real tras derating termico/config; cfg = limite configurado con DTI CAN tool.";
CM_ BO_ 1217 "Packet 0x26. INV_MaxDC_avail es el dato util para cerrar el lazo de derating del BMS (cuanta corriente de descarga le queda disponible al inversor).";
CM_ SG_ 993 INV_ControlMode "1=SPEED 2=CURRENT 3=CURRENT_BRAKE 4=POS 7=NONE (0,5,6 sin usar).";
CM_ SG_ 993 INV_MotorStill "1=parado 0=girando.";
CM_ SG_ 1089 INV_FaultCode "Ver VAL_. 0=OK.";

VAL_ 993 INV_ControlMode 0 "unused" 1 "SPEED" 2 "CURRENT" 3 "CURRENT_BRAKE" 4 "POS" 5 "unused" 6 "unused" 7 "NONE" ;
VAL_ 1089 INV_FaultCode 0 "OK" 1 "Overvoltage" 2 "Undervoltage" 3 "DRV" 4 "Overcurrent" 5 "CtrlOverTemp" 6 "MotorOverTemp" 7 "SensorWire" 8 "SensorGeneral" 9 "CANcmdError" 10 "AnalogInput" ;

CM_ BO_ 1160 "VCU_26, src/Control.cpp publishTelemetry() (rev 2026-08-10). Bytes4-7 reservados a 0.";
CM_ BO_ 1166 "Señales de estado de la VCU. VCU_Bypass=1 es el bypass de banco (opcion 21 del menu serie): par habilitado saltandose SDC/secuencia/freno/APPS. No deberia verse nunca en pista -> alarma en dashboard.";
CM_ SG_ 1160 VCU_FaultCause "Causa de no-R2D, primera que aplica: 0=OK 1=esperando start+freno 2=SDC abierto 3=APPS implausible 6=freno desconectado/corto 7=BYPASS DE BANCO ACTIVO (prioridad sobre todos). 4 y 5 no existen en VCU_26.";
CM_ SG_ 1160 VCU_ResetCause "0=desconocido 1=power/BOR 2=NRST 3=SW 4=IWDG 5=WWDG 6=lowpwr.";
CM_ SG_ 1160 VCU_Heartbeat "Cuenta de loop; se congela si el firmware de la VCU se cuelga. Combinar con VCU_ResetCause=4(IWDG) para detectar cuelgue->reset.";
CM_ SG_ 1166 VCU_R2D "Logica positiva (1=R2D activo) aunque el pin de salida real es activo-bajo.";
CM_ SG_ 1166 VCU_AppsSt "0=NORMAL 1=IMPL 2=PENDING.";
CM_ SG_ 1166 VCU_Bypass "Ver comentario del mensaje BO_ 1166.";

VAL_ 1160 VCU_FaultCause 0 "OK" 1 "WaitStartBrake" 2 "SDCopen" 3 "AppsImplausible" 6 "BrakeFault" 7 "BYPASS_BANCO" ;
VAL_ 1160 VCU_ResetCause 0 "unknown" 1 "PowerBOR" 2 "NRST" 3 "SW" 4 "IWDG" 5 "WWDG" 6 "lowpower" ;
VAL_ 1166 VCU_AppsSt 0 "NORMAL" 1 "IMPL" 2 "PENDING" ;

CM_ BO_ 769 "mart-PDM, src/main.cpp sendPdmStatus() (rev 2026-10-10). Bomba+ventiladores del inversor DTI HV-500. Bytes4-7 relleno 0xFF.";
CM_ SG_ 769 PDM_Mode "Quien manda sobre la refrigeracion: 0=AUTO (curva termica por temps del inversor, 0x441) 1=CAN (consigna de la VCU, 0x300) 2=SERIAL (override manual de banco).";
CM_ SG_ 769 PDM_Failsafe "1 = sin temperaturas del inversor -> demanda fija de emergencia (nunca se apaga).";
CM_ SG_ 769 PDM_SafetyFloor "1 = cerca del limite termico, la curva ha subido la consigna de CAN/serie por encima de lo pedido.";

VAL_ 769 PDM_Mode 0 "AUTO" 1 "CAN" 2 "SERIAL" ;
